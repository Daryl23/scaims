  <script>
    /* ── Mobile Menu ── */
    /* ── Scroll reveal ── */
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        e.target.classList.add('active');
        e.target.querySelectorAll('.counter').forEach(c => {
          if (!c.classList.contains('counted')) { animateCounter(c, +c.dataset.target); c.classList.add('counted'); }
        });
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

    function animateCounter(el, target) {
      let cur = 0, inc = target / 50;
      const t = setInterval(() => {
        cur += inc;
        if (cur >= target) { el.textContent = target.toLocaleString(); clearInterval(t); }
        else el.textContent = Math.floor(cur).toLocaleString();
      }, 30);
    }

    /* ── Modals ── */
    function openModal()  { _openM('suggestionModal','modalContent'); }
    function closeModal() { _closeM('suggestionModal','modalContent'); }
    function openLoginModal()  { _openM('loginModal','loginModalContent'); }
    function closeLoginModal() { _closeM('loginModal','loginModalContent'); }
    function _openM(mId, cId) {
      document.getElementById(mId).classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => { const c = document.getElementById(cId); c.classList.remove('scale-95','opacity-0'); c.classList.add('scale-100','opacity-100'); }, 10);
    }
    function _closeM(mId, cId) {
      const c = document.getElementById(cId);
      c.classList.remove('scale-100','opacity-100'); c.classList.add('scale-95','opacity-0');
      setTimeout(() => { document.getElementById(mId).classList.add('hidden'); document.body.style.overflow = ''; }, 300);
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); closeLoginModal(); } });

    /* ════════════════════════════════════
       HERO CAROUSEL
    ════════════════════════════════════ */
    const SLIDES = 12;
    const DELAY  = 4500;

    let cur = 0, playing = true, timer = null;
    const track  = document.getElementById('cTrack');
    const slides = document.querySelectorAll('.carousel-slide');
    const dotsEl = document.getElementById('cDots');
    const ctrEl  = document.getElementById('cCounter');

    /* Build dots */
    for (let i = 0; i < SLIDES; i++) {
      const d = document.createElement('button');
      d.className = 'c-dot' + (i === 0 ? ' on' : '');
      d.setAttribute('aria-label', `Slide ${i+1}`);
      d.addEventListener('click', () => { goTo(i); resetTimer(); });
      dotsEl.appendChild(d);
    }

    function goTo(n) {
      slides[cur].classList.remove('is-active');
      dotsEl.children[cur].classList.remove('on');
      cur = ((n % SLIDES) + SLIDES) % SLIDES;
      slides[cur].classList.add('is-active');
      dotsEl.children[cur].classList.add('on');
      track.style.transform = `translateX(-${cur * 100}%)`;
      ctrEl.textContent = `${cur + 1} / ${SLIDES}`;
    }

    function cMove(dir) { goTo(cur + dir); resetTimer(); }

    function startTimer() { timer = setInterval(() => goTo(cur + 1), DELAY); }
    function resetTimer() { if (!playing) return; clearInterval(timer); startTimer(); }

    function cTogglePlay() {
      playing = !playing;
      document.getElementById('icoP').style.display = playing ? '' : 'none';
      document.getElementById('icoR').style.display = playing ? 'none' : '';
      playing ? startTimer() : clearInterval(timer);
    }

    /* Touch swipe */
    let tx = 0;
    const hc = document.getElementById('heroCarousel');
    hc.addEventListener('touchstart', e => { tx = e.changedTouches[0].clientX; }, { passive: true });
    hc.addEventListener('touchend',   e => { const d = tx - e.changedTouches[0].clientX; if (Math.abs(d) > 40) cMove(d > 0 ? 1 : -1); });

    /* Pause on hover */
    hc.addEventListener('mouseenter', () => clearInterval(timer));
    hc.addEventListener('mouseleave', () => { if (playing) startTimer(); });

    /* Keyboard */
    hc.setAttribute('tabindex', '0');
    hc.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') cMove(-1); if (e.key === 'ArrowRight') cMove(1); });

    startTimer();
  </script>

  <style>
    html { scroll-behavior: smooth; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #fffcef; }
    ::-webkit-scrollbar-thumb { background: #3b4918; border-radius: 4px; }

    /* ─── Hero Carousel ─── */
    .hero-carousel-wrap {
      position: relative;
    }
    /* decorative rotated bg plate */
    .hero-carousel-wrap::before {
      content: '';
      position: absolute;
      inset: -10px;
      border-radius: 28px;
      background: linear-gradient(135deg, rgba(200,189,68,0.20), rgba(247,147,30,0.14));
      transform: rotate(2.5deg);
      z-index: 0;
    }
    .hero-carousel {
      position: relative;
      z-index: 1;
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 20px;
      overflow: hidden;
      box-shadow:
        0 30px 60px -15px rgba(59,73,24,0.32),
        0 0 0 1px rgba(200,189,68,0.22);
    }
    .carousel-track {
      display: flex;
      height: 100%;
      transition: transform 0.72s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .carousel-slide {
      min-width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
    }
    .carousel-slide img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 8s ease;
    }
    .carousel-slide.is-active img { transform: scale(1.05); }
    /* bottom fade overlay */
    .carousel-slide::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 32%;
      background: linear-gradient(to top, rgba(42,51,17,0.60), transparent);
      pointer-events: none;
    }

    /* Nav arrows */
    .c-btn {
      position: absolute; top: 50%; transform: translateY(-50%);
      z-index: 10; width: 38px; height: 38px; border-radius: 50%;
      background: rgba(255,252,239,0.88); backdrop-filter: blur(6px);
      border: 1px solid rgba(200,189,68,0.28);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; color: #3b4918;
      transition: background 0.22s, color 0.22s, transform 0.22s, box-shadow 0.22s;
    }
    .c-btn:hover {
      background: #f7931e; color: #fff;
      box-shadow: 0 4px 18px rgba(247,147,30,0.40);
      transform: translateY(-50%) scale(1.10);
    }
    .c-btn-prev { left: 12px; }
    .c-btn-next { right: 12px; }

    /* Dots */
    .c-dots {
      position: absolute; bottom: 13px; left: 50%; transform: translateX(-50%);
      z-index: 10; display: flex; gap: 5px; align-items: center;
    }
    .c-dot {
      width: 7px; height: 7px; border-radius: 999px;
      background: rgba(255,255,255,0.40);
      border: none; cursor: pointer; padding: 0;
      transition: background 0.28s, width 0.28s, box-shadow 0.28s;
    }
    .c-dot.on { background: #f7931e; width: 22px; box-shadow: 0 0 8px rgba(247,147,30,0.50); }

    /* Counter badge */
    .c-counter {
      position: absolute; top: 12px; right: 12px; z-index: 10;
      background: rgba(255,252,239,0.86); backdrop-filter: blur(6px);
      border: 1px solid rgba(200,189,68,0.22); border-radius: 999px;
      padding: 3px 11px; font-size: 11px; font-weight: 700;
      color: #3b4918; letter-spacing: 0.04em;
    }

    /* Play/Pause */
    .c-playpause {
      position: absolute; bottom: 12px; right: 12px; z-index: 10;
      width: 30px; height: 30px; border-radius: 50%;
      background: rgba(255,252,239,0.86); backdrop-filter: blur(6px);
      border: 1px solid rgba(200,189,68,0.22);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; color: #3b4918;
      transition: background 0.22s, color 0.22s;
    }
    .c-playpause:hover { background: #3b4918; color: #fffcef; }
  </style>
